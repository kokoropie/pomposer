<?php

/*
 * Runs a static Composer script handler (Class::method) in the project's context.
 * Usage: php run-script.php.stub <Class> <method> <event-name> <dev-mode 1|0>   (cwd = project root)
 */

[, $class, $method, $eventName] = $argv;
$devMode = ($argv[4] ?? '1') === '1';

require __DIR__ . '/ComposerScriptEvent.php.stub';

$vendorDir = getcwd() . '/vendor';
require_once $vendorDir . '/autoload.php';

$config = new Composer\Config([
    'vendor-dir' => $vendorDir,
    'bin-dir' => $vendorDir . '/bin',
]);

$event = new Composer\Script\Event($eventName, new Composer\Composer($config), new Composer\IO\ConsoleIO(), $devMode);

$class::$method($event);

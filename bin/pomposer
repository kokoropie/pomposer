#!/usr/bin/env php
<?php

use HichemTabTech\Pomposer\Console\DumpAutoloadCommand;
use HichemTabTech\Pomposer\Console\InstallCommand;
use HichemTabTech\Pomposer\Console\RemoveCommand;
use HichemTabTech\Pomposer\Console\RequireCommand;
use HichemTabTech\Pomposer\Console\RequireDevCommand;
use HichemTabTech\Pomposer\Console\RunScriptCommand;
use HichemTabTech\Pomposer\Console\ScriptAliasCommand;
use HichemTabTech\Pomposer\Console\UpdateCommand;

if (file_exists(__DIR__.'/../../../autoload.php')) {
    /** @noinspection PhpIncludeInspection */
    require __DIR__.'/../../../autoload.php';
} else {
    require __DIR__.'/../vendor/autoload.php';
}

// Define our own version and the Laravel Installer version we aim to match.
$pomposerVersion = '0.1.0';

// Compose the displayed version string.
$displayVersion = sprintf('%s', $pomposerVersion);

$app = new Symfony\Component\Console\Application('Pomposer', $displayVersion);
$app->add(new InstallCommand);
$app->add(new UpdateCommand);
$app->add(new RequireCommand);
$app->add(new RequireDevCommand);
$app->add(new RemoveCommand);
$app->add(new DumpAutoloadCommand);
$app->add(new RunScriptCommand);

// Custom scripts of ./composer.json become commands too (`pomposer test`), like Composer.
ScriptAliasCommand::registerAll($app);

/** @noinspection PhpUnhandledExceptionInspection */
$app->run();
